{
  "name": "vrc-studio",
  "version": "1.0.0",
  "description": "VRC Studio \u2014 A professional VRChat companion application",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "VRC Studio Team",
  "license": "MIT",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite",
    "dev:web": "ELECTRON=false vite",
    "build": "vite build && electron-builder",
    "build:web": "ELECTRON=false vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "discord-rpc": "^4.0.1",
    "discord.js": "^14.26.4",
    "lucide-react": "^0.441.0",
    "osc": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^6.0.2",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.vrcstudio.app",
    "productName": "VRC Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/icon.png",
      "public/tray-icon.png"
    ],
    "extraResources": [
      {
        "from": "public/icon.png",
        "to": "icon.png"
      },
      {
        "from": "public/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "VRC Studio.exe"
    },
    "portable": {
      "artifactName": "VRC Studio.exe"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    }
  }
}